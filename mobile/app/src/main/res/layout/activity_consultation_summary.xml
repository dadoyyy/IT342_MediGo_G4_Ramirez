<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════════
     MediGo — Consultation Summary (Premium Redesign)
     ════════════════════════════════════════════════════════════════════════ -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist">

    <!-- ── Static Compact Header (Locked) ────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/navy"
        android:layout_alignParentTop="true">

        <View
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-60dp"
            android:layout_marginTop="-60dp"
            android:background="@drawable/bg_auth_orb_crimson" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_back_button_circle"
                android:backgroundTint="#20FFFFFF"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Consultation Summary"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:includeFontPadding="false" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/PageHeroPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPORTS"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ── Scrollable Content Area ────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topHeader"
        android:layout_alignParentBottom="true"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:indeterminateTint="@color/crimson"
                android:visibility="gone" />

            <!-- Doctor & consultation info -->
            <androidx.cardview.widget.CardView
                style="@style/SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_icon_box_light_crimson"
                        android:src="@drawable/ic_medigo_logo_stethoscope"
                        app:tint="@color/crimson"
                        android:padding="12dp"
                        android:contentDescription="Stethoscope icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tvHeaderName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/navy"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:text="Dr. Ruther Ramirez"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvConsultationDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins"
                            android:text="Medium: In-Clinic • Date: Monday, May 18"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Diagnosis & Treatment -->
            <androidx.cardview.widget.CardView
                style="@style/SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diagnosis &amp; Treatment Summary"
                        android:textColor="@color/navy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="10dp"
                        android:includeFontPadding="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EBEBF0"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvDiagnosisNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="@font/poppins"
                        android:text="Retrieving medical notes..." />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Follow-up -->
            <androidx.cardview.widget.CardView
                style="@style/SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recommended Follow-up"
                        android:textColor="@color/navy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="10dp"
                        android:includeFontPadding="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EBEBF0"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvFollowUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="@font/poppins"
                        android:text="No follow-up configured." />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Attachment card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutAttachmentCard"
                style="@style/SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prescription &amp; Lab Requests"
                        android:textColor="@color/navy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="10dp"
                        android:includeFontPadding="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EBEBF0"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#FFF5F6"
                        android:padding="14dp"
                        android:layout_marginBottom="18dp">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_box_light_crimson"
                            android:src="@drawable/ic_medigo_logo_stethoscope"
                            app:tint="@color/crimson"
                            android:padding="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prescription_Signed.pdf"
                                android:textColor="@color/navy"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Official Digital Medical Document"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:fontFamily="@font/poppins"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDownloadPdf"
                        style="@style/ButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Download &amp; View Signed PDF"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Footer text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="@font/poppins"
                android:text="Your digital clinical records are securely processed. Contact support if you need revisions."
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="100dp" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
