<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Title and Specialization Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDoctorName"
            style="@style/TextHeading3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dr. Ruther Ramirez"
            android:textColor="@color/primary_accent" />

        <TextView
            android:id="@+id/tvSpecializationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_status_box_error"
            android:textColor="@color/primary"
            android:text="CARDIOLOGY"
            android:textStyle="bold"
            android:textSize="10sp"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Clinic Details -->
    <TextView
        android:id="@+id/tvClinicDetails"
        style="@style/TextCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:text="MediGo Specialist Clinic, Room 402" />

    <!-- Details Grid (Experience and Fee) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <!-- Experience -->
        <TextView
            android:id="@+id/tvExperience"
            style="@style/TextBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:text="Experience: 8 years" />

        <!-- Consultation Fee -->
        <TextView
            android:id="@+id/tvConsultationFee"
            style="@style/TextHeading3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/success"
            android:textSize="14sp"
            android:text="₱500.00" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp" />

    <!-- Footer Action -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="View Consultation Profile →"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
