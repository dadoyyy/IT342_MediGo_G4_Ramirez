<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════════
     MediGo — Patient Profile Bottom Sheet Modal
     ════════════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard_card"
    android:backgroundTint="@color/white"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Bottom sheet drag handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#D1D5DB"
        android:layout_marginBottom="24dp" />

    <!-- Avatar Circle -->
    <androidx.cardview.widget.CardView
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFE6E8"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvModalAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="PT"
            android:textColor="#EF233C"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />
    </androidx.cardview.widget.CardView>

    <!-- Name and Details -->
    <TextView
        android:id="@+id/tvModalFullName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ruther Ramirez"
        android:textColor="@color/navy"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins" />

    <TextView
        android:id="@+id/tvModalEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ruther@medigo.app"
        android:textColor="@color/slate"
        android:textSize="13sp"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light"
        android:layout_marginBottom="24dp" />

    <!-- Sign Out Button -->
    <TextView
        android:id="@+id/btnModalSignOut"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@color/crimson"
        android:gravity="center"
        android:text="Sign Out"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
