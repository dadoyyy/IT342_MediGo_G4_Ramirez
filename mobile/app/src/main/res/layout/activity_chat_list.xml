<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════════
     MediGo — Chat List (Consultation Messenger)
     ════════════════════════════════════════════════════════════════════════ -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist">

    <!-- ── Hero Header (Static) ────────────────────────────── -->
    <FrameLayout
        android:id="@+id/topHeader"
        style="@style/PageHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <View
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-100dp"
            android:layout_marginTop="-70dp"
            android:background="@drawable/bg_auth_orb_crimson" />

        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-110dp"
            android:layout_marginEnd="-120dp"
            android:background="@drawable/bg_auth_orb_slate" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Inline Top Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <!-- Left side Title -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inboxes"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Messages"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Actions (Right) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Notification Bell -->
                    <ImageView
                        android:id="@+id/btnNotifications"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_back_button_circle"
                        android:backgroundTint="#20FFFFFF"
                        android:padding="10dp"
                        android:src="@drawable/ic_bell_outline"
                        app:tint="@color/white"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Notifications"
                        android:layout_marginEnd="10dp" />

                    <!-- Profile Avatar -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white">

                        <TextView
                            android:id="@+id/btnOpenProfile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="PT"
                            android:textColor="@color/navy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:clickable="true"
                            android:focusable="true" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Tagline -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Securely coordinate follow-ups, share updates, and keep every consultation thread in one place."
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="16dp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- Scrollable main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topHeader"
        android:layout_alignParentBottom="true"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:layout_marginTop="16dp">

            <!-- Search card -->
            <androidx.cardview.widget.CardView
                style="@style/SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SEARCH CONVERSATIONS" />

                    <EditText
                        android:id="@+id/etSearchContacts"
                        style="@style/InputField"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:hint="Search doctor or patient name..."
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawablePadding="10dp"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recent threads -->
            <androidx.cardview.widget.CardView
                style="@style/SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="10dp">

                        <TextView
                            style="@style/SectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RECENT THREADS" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to open"
                            android:textColor="@color/crimson"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="320dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvContacts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:clipToPadding="false" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/crimson"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layoutEmptyState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="32dp"
                            android:visibility="gone">

                            <View
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_icon_circle_crimson"
                                android:foreground="@drawable/ic_mail"
                                android:foregroundGravity="center"
                                android:layout_marginBottom="16dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No Active Chats"
                                android:textColor="@color/navy"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Book a consultation slot to initiate secure chat channels."
                                android:gravity="center"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom spacer for navbar overlay (inside scroll) -->
            <View
                android:id="@+id/bottomSpacerForNav"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
