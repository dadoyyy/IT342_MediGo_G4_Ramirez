<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_selectable_card"
    android:elevation="1dp">

    <!-- Time and Date Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSlotTime"
            style="@style/TextHeading3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:text="09:00 AM - 10:00 AM"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvSlotDate"
            style="@style/TextBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:text="Wednesday, May 21, 2026"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Consultation Type Badge -->
    <TextView
        android:id="@+id/tvSlotTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_status_box_success"
        android:textColor="@color/success"
        android:text="ONLINE"
        android:textStyle="bold"
        android:textSize="10sp"
        android:letterSpacing="0.04" />

    <!-- Delete Button -->
    <ImageView
        android:id="@+id/btnDeleteSlot"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Delete Slot" />

</LinearLayout>
