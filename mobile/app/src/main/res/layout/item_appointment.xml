<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════════
     MediGo — Appointment Card Item
     ════════════════════════════════════════════════════════════════════════ -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/white"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Doctor + status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_box_light_crimson"
                android:src="@drawable/ic_medigo_logo_stethoscope"
                app:tint="@color/crimson"
                android:padding="10dp"
                android:contentDescription="Stethoscope logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvAppointmentHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Ruther Ramirez"
                    android:textColor="@color/navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvAppointmentType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Medium: In-Clinic Consultation"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_completed"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="CONFIRMED"
                android:textColor="@color/success"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Date/time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_icon_circle_navy"
                android:foreground="@drawable/ic_calendar_outline"
                android:foregroundGravity="center" />

            <TextView
                android:id="@+id/tvAppointmentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Monday, May 18, 2026 at 10:00 AM"
                android:textColor="@color/navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <!-- Notes -->
        <TextView
            android:id="@+id/tvAppointmentNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_unified"
            android:padding="14dp"
            android:text="Notes: Regular cardiology checkup."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/poppins"
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="2dp" />

        <!-- Action area -->
        <LinearLayout
            android:id="@+id/layoutActionArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/bg_divider_subtle"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnPatientCancel"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="Cancel Booking"
                    android:textColor="@color/crimson"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnDoctorReject"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="Reject"
                    android:textColor="@color/crimson"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnDoctorConfirm"
                    style="@style/ButtonPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="8dp"
                    android:text="Confirm Slot"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
