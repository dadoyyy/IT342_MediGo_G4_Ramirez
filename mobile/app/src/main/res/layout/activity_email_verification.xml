<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/gray_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_vertical">

        <!-- Animated/Premium Check Email Shield Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="36dp">

            <!-- Beautiful circle container representing envelope/verification -->
            <View
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_status_box_success"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                style="@style/TextHeading1"
                android:text="Verify Your Email"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- Message Body Card -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <TextView
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="We have sent an activation link to your registered email address. Please open the email and click the link to verify your identity." />

            <!-- Registered Email Highlight Box -->
            <TextView
                android:id="@+id/tvTargetEmail"
                style="@style/SuccessMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/primary"
                android:background="@drawable/bg_status_box_success"
                android:text="your.email@example.com"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Instruction Tip -->
        <TextView
            style="@style/TextCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="36dp"
            android:textColor="@color/text_secondary"
            android:text="Once verified, you will be able to access your patient dashboard or start managing your practice as a doctor." />

        <!-- Return to Login Button -->
        <Button
            android:id="@+id/btnBackToLogin"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue to Sign In" />

    </LinearLayout>
</ScrollView>
