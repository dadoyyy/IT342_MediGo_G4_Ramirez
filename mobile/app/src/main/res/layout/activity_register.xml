<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#EDF2F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardMaxElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_margin="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <!-- ==================== STEP 1: ROLE SELECTION CONTAINER ==================== -->
                <LinearLayout
                    android:id="@+id/llRoleContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Consistent Branding Placement (Logo + Text) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="28dp">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_logo"
                            android:foreground="@drawable/ic_stethoscope"
                            android:foregroundGravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="MediGo"
                            android:textSize="24sp"
                            android:textColor="#2B2D42"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02" />
                    </LinearLayout>

                    <!-- Headline Header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Join MediGo"
                        android:textSize="28sp"
                        android:textColor="#2B2D42"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select your portal to proceed with registration"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif"
                        android:layout_marginBottom="28dp" />

                    <!-- Patient Select Card -->
                    <LinearLayout
                        android:id="@+id/llPatientCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_selectable_card"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="#14EF233C"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_patient" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Patient Portal"
                                android:textSize="16sp"
                                android:textColor="#2B2D42"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Book appointments, track medical history &amp; consult"
                                android:textSize="12sp"
                                android:textColor="#8D99AE"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Doctor Select Card -->
                    <LinearLayout
                        android:id="@+id/llDoctorCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_selectable_card"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="28dp">

                        <LinearLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="#142B2D42"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_stethoscope"
                                app:tint="#2B2D42" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Doctor Portal"
                                android:textSize="16sp"
                                android:textColor="#2B2D42"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Manage practice, schedules &amp; medical records securely"
                                android:textSize="12sp"
                                android:textColor="#8D99AE"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Google SSO Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#142B2D42" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="OR"
                            android:textSize="11sp"
                            android:textColor="#8D99AE"
                            android:fontFamily="sans-serif-medium" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#142B2D42" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnGoogleSignUp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_button_secondary"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="20dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_google" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Sign up with Google"
                            android:textSize="15sp"
                            android:textColor="#2B2D42"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Go to Login -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Already registered? "
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:fontFamily="sans-serif" />
                        <TextView
                            android:id="@+id/tvGoToLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Access Portal"
                            android:textSize="14sp"
                            android:textColor="#EF233C"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ==================== STEP 2: INPUT FORM CONTAINER ==================== -->
                <LinearLayout
                    android:id="@+id/llFormContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Custom Glass Back Navigation Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="28dp">

                        <ImageView
                            android:id="@+id/btnBackToRole"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_button_secondary"
                            android:src="@drawable/ic_arrow_back"
                            android:scaleType="centerInside"
                            android:clickable="true"
                            android:focusable="true" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/tvFormHeaderTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Account Setup"
                                android:textSize="20sp"
                                android:textColor="#2B2D42"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold"
                                android:letterSpacing="-0.01" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Provide your profile details"
                                android:textSize="12sp"
                                android:textColor="#6B7280"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Collapsible Premium Error Message Card -->
                    <TextView
                        android:id="@+id/tvErrorCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_box_error"
                        android:padding="14dp"
                        android:textSize="13sp"
                        android:textColor="#D90429"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone"
                        android:layout_marginBottom="20dp"
                        android:text="Error details go here." />

                    <!-- First Name Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="First Name"
                            android:textSize="12sp"
                            android:textColor="#2B2D42"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/etFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input"
                            android:hint="John"
                            android:textColorHint="#8D99AE"
                            android:textColor="#2B2D42"
                            android:textSize="15sp"
                            android:inputType="textPersonName"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />
                    </LinearLayout>

                    <!-- Last Name Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Last Name"
                            android:textSize="12sp"
                            android:textColor="#2B2D42"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/etLastName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input"
                            android:hint="Doe"
                            android:textColorHint="#8D99AE"
                            android:textColor="#2B2D42"
                            android:textSize="15sp"
                            android:inputType="textPersonName"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />
                    </LinearLayout>

                    <!-- Email Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Email Address"
                            android:textSize="12sp"
                            android:textColor="#2B2D42"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input"
                            android:hint="john.doe@example.com"
                            android:textColorHint="#8D99AE"
                            android:textColor="#2B2D42"
                            android:textSize="15sp"
                            android:inputType="textEmailAddress"
                            android:paddingStart="48dp"
                            android:paddingEnd="16dp"
                            android:drawableStart="@drawable/ic_mail"
                            android:drawablePadding="-32dp" />
                    </LinearLayout>

                    <!-- Password Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Password"
                            android:textSize="12sp"
                            android:textColor="#2B2D42"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input"
                            android:hint="••••••••"
                            android:textColorHint="#8D99AE"
                            android:textColor="#2B2D42"
                            android:textSize="15sp"
                            android:inputType="textPassword"
                            android:paddingStart="48dp"
                            android:paddingEnd="16dp"
                            android:drawableStart="@drawable/ic_lock"
                            android:drawablePadding="-32dp" />
                    </LinearLayout>

                    <!-- Doctor's License Field Container -->
                    <LinearLayout
                        android:id="@+id/licenseContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="24dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PRC License Number"
                            android:textSize="12sp"
                            android:textColor="#2B2D42"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />
                        <EditText
                            android:id="@+id/etLicenseNumber"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input"
                            android:hint="1234567"
                            android:textColorHint="#8D99AE"
                            android:textColor="#2B2D42"
                            android:textSize="15sp"
                            android:inputType="number"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />
                    </LinearLayout>

                    <!-- Register Button -->
                    <Button
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_button_primary"
                        app:backgroundTint="@null"
                        android:text="Initialize Account"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
