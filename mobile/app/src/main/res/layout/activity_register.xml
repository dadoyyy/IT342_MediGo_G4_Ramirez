<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════════
     MediGo — Sign Up Bottom Sheet Dialog
     ════════════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Semitransparent backdrop for modal feel -->
    <View
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA11131E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top pill indicator for bottom sheet gesture visual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_patient_pill_inactive" />
        </LinearLayout>

        <!-- Bottom Sheet Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="24dp"
            app:cardUseCompatPadding="false">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <ImageView
                            android:id="@+id/ivBackToLogin"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="8dp"
                            android:background="@drawable/bg_back_button_circle"
                            android:src="@drawable/ic_arrow_back"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Back to login" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Create account"
                                android:textColor="@color/navy"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-black"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Join MediGo to coordinate with specialists"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Error card -->
                    <TextView
                        android:id="@+id/tvErrorCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_box_error"
                        android:padding="14dp"
                        android:textColor="@color/ruby"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp" />

                    <!-- Google signup -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="18dp">

                        <LinearLayout
                            android:id="@+id/btnGoogleSignUp"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_auth_secondary_button"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_google" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="Continue with Google"
                                android:textColor="@color/navy"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider OR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_divider_subtle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="14dp"
                            android:text="OR REGISTER VIA EMAIL"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_divider_subtle" />
                    </LinearLayout>

                    <!-- First name / Last name row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                style="@style/SectionLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="FIRST NAME"
                                android:layout_marginBottom="6dp" />

                            <EditText
                                android:id="@+id/etFirstName"
                                style="@style/InputField"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="John"
                                android:inputType="textPersonName"
                                android:importantForAutofill="no" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                style="@style/SectionLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="LAST NAME"
                                android:layout_marginBottom="6dp" />

                            <EditText
                                android:id="@+id/etLastName"
                                style="@style/InputField"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="Doe"
                                android:inputType="textPersonName"
                                android:importantForAutofill="no" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Email Field -->
                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EMAIL ADDRESS"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etEmail"
                        style="@style/InputField"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="john.doe@example.com"
                        android:inputType="textEmailAddress"
                        android:importantForAutofill="no"
                        android:layout_marginBottom="14dp" />

                    <!-- Password Field -->
                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PASSWORD"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etPassword"
                        style="@style/InputField"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Min 8 characters"
                        android:inputType="textPassword"
                        android:importantForAutofill="no"
                        android:layout_marginBottom="16dp" />

                    <!-- Checkbox Consent -->
                    <CheckBox
                        android:id="@+id/cbPrivacyConsent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="I agree to the privacy policy and terms of service"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:buttonTint="@color/crimson"
                        android:layout_marginBottom="20dp" />

                    <!-- Submit Button -->
                    <Button
                        android:id="@+id/btnRegister"
                        style="@style/ButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Create Patient Account" />

                    <!-- Footer Link -->
                    <TextView
                        android:id="@+id/tvGoToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:text="Already have an account? Sign in"
                        android:textColor="@color/crimson"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</FrameLayout>
