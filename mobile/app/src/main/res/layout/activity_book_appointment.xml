<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════════
     MediGo — Book Appointment
     ════════════════════════════════════════════════════════════════════════ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Hero Header ─────────────────────────────────────── -->
        <FrameLayout
            style="@style/PageHero"
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="-100dp"
                android:layout_marginTop="-70dp"
                android:background="@drawable/bg_auth_orb_crimson" />

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-110dp"
                android:layout_marginEnd="-120dp"
                android:background="@drawable/bg_auth_orb_slate" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_back_button_circle"
                        android:clickable="true"
                        android:contentDescription="Back"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_back" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/PageHeroPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BOOKING" />
                </LinearLayout>

                <TextView
                    style="@style/PageHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Schedule Booking" />

                <TextView
                    style="@style/PageHeroSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Choose a date, time, and consultation style that fits your visit." />
            </LinearLayout>
        </FrameLayout>

        <!-- ── Content ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-22dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Error card -->
            <TextView
                android:id="@+id/tvErrorCard"
                style="@style/ErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <!-- Booking summary -->
            <androidx.cardview.widget.CardView
                style="@style/SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BOOKING SUMMARY" />

                    <TextView
                        android:id="@+id/tvSummaryDoctorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/primary_accent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:text="Dr. Ruther Ramirez" />

                    <TextView
                        android:id="@+id/tvSummaryDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="sans-serif"
                        android:text="Cardiology • Consultation Fee: ₱500.00" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Scheduling form -->
            <androidx.cardview.widget.CardView
                style="@style/SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Date picker -->
                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SELECT APPOINTMENT DATE" />

                    <LinearLayout
                        android:id="@+id/btnSelectDate"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="22dp"
                        android:background="@drawable/bg_input_unified"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvSelectedDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:textColor="@color/navy"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:text="Monday, May 18, 2026" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Change"
                            android:textColor="@color/crimson"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Time slots -->
                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CHOOSE AVAILABLE HOUR SLOT" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="22dp"
                        android:columnCount="3"
                        android:rowCount="3"
                        android:alignmentMode="alignBounds">

                        <TextView
                            android:id="@+id/slot09"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="09:00 AM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/slot10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="10:00 AM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/slot11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="11:00 AM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/slot13"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="01:00 PM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/slot14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="02:00 PM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/slot15"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="03:00 PM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/slot16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="04:00 PM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/slot17"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:padding="14dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="05:00 PM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />
                    </GridLayout>

                    <!-- Consultation medium -->
                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CONSULTATION MEDIUM" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="22dp">

                        <TextView
                            android:id="@+id/btnTypeInClinic"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="In-Clinic Visit"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnTypeVirtual"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_time_slot_default"
                            android:gravity="center"
                            android:text="Virtual Chat"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/navy"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Notes -->
                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CONSULTATION NOTES / SYMPTOMS" />

                    <EditText
                        android:id="@+id/etNotes"
                        style="@style/InputField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="110dp"
                        android:gravity="top|start"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="24dp"
                        android:padding="16dp"
                        android:hint="Describe your symptoms or medical concern..."
                        android:inputType="textMultiLine"
                        android:scrollbars="vertical"
                        android:importantForAutofill="no" />

                    <!-- CTA -->
                    <Button
                        android:id="@+id/btnConfirmBooking"
                        style="@style/ButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Confirm Scheduling Request" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
