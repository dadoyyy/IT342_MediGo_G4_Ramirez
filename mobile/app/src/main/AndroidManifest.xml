<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mobile"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Patient-Only Activities -->
        <activity
            android:name=".features.dashboard.DashboardActivity"
            android:exported="false" />
        <activity
            android:name=".features.patient.SearchDoctorsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.patient.DoctorDetailActivity"
            android:exported="false" />
        <activity
            android:name=".features.patient.BookAppointmentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.patient.AppointmentsListActivity"
            android:exported="false" />
        <activity
            android:name=".features.patient.ConsultationSummaryActivity"
            android:exported="false" />
        <activity
            android:name=".features.patient.PatientProfileActivity"
            android:exported="false" />
        <activity
            android:name=".features.patient.ChatListActivity"
            android:exported="false" />
        <activity
            android:name=".features.patient.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Auth Activities -->
        <activity
            android:name=".features.auth.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Mobile.AuthModal" />
        <activity
            android:name=".features.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Mobile.AuthModal" />
        <activity
            android:name=".features.auth.OAuthActivity"
            android:exported="false" />
        <activity
            android:name=".features.auth.EmailVerificationActivity"
            android:exported="false" />

        <!-- Launcher -->
        <activity
            android:name=".features.dashboard.MainActivity"
            android:exported="true">
            <intent-filter>
               <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>